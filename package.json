{
  "name": "thingsboard-ui-vue3",
  "version": "4.3.1",
  "description": "Vue 3 frontend for ThingsBoard, built with Vben Admin, Vite, TypeScript and antdv-next.",
  "keywords": [
    "thingsboard",
    "iot",
    "dashboard",
    "vue3",
    "typescript",
    "vite",
    "antdv-next",
    "vben"
  ],
  "homepage": "https://github.com/oliver225/thingsboard-ui-vue3",
  "bugs": {
    "url": "https://github.com/oliver225/thingsboard-ui-vue3/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliver225/thingsboard-ui-vue3.git"
  },
  "license": "MIT",
  "author": {
    "name": "oliver225",
    "url": "https://github.com/oliver225"
  },
  "contributors": [
    {
      "name": "vben",
      "email": "ann.vben@gmail.com",
      "url": "https://github.com/anncwb"
    }
  ],
  "type": "module",
  "scripts": {
    "bootstrap": "pnpm install",
    "build": "pnpm run build:thingsboard",
    "build:all": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:analyze": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm -F thingsboard-ui build:analyze",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "build:docs": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build --filter=@vben/docs",
    "build:thingsboard": "cross-env NODE_OPTIONS=--max-old-space-size=8192 pnpm -F thingsboard-ui build",
    "catalog": "pnpm dlx codemod pnpm/catalog",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint \"**/*.ts\" \"**/README.md\" \".changeset/*.md\" --no-progress",
    "check:dep": "vsh check-dep",
    "check:thingsboard": "pnpm -F thingsboard-ui typecheck",
    "check:type": "turbo run typecheck",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "pnpm -F thingsboard-ui dev",
    "dev:docs": "pnpm -F @vben/docs run dev",
    "dev:thingsboard": "pnpm -F thingsboard-ui dev",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "postinstall": "pnpm -r run --if-present stub",
    "preinstall": "npx only-allow pnpm",
    "prepare": "is-ci || pnpm exec lefthook install",
    "preview": "pnpm -F thingsboard-ui preview",
    "publint": "vsh publint",
    "reinstall": "pnpm run clean -- --del-lock && pnpm install",
    "update:deps": "npx taze -r -w",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile"
  },
  "dependencies": {
    "sortablejs": "catalog:"
  },
  "devDependencies": {
    "@changesets/changelog-github": "catalog:",
    "@changesets/cli": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vben/commitlint-config": "workspace:*",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxfmt-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/turbo-run": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vben/vsh": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "cross-env": "catalog:",
    "cspell": "catalog:",
    "eslint": "catalog:",
    "is-ci": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "rimraf": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "^22.18.0 || ^24.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.16.0"
}
